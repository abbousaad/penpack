# -----------------------------------------------------------------------------
# Copy to `.env` to customize. Docker Compose reads `.env` automatically.
# All values shown are the built-in defaults (safe for local lab use only).
# -----------------------------------------------------------------------------

# ---- BloodHound CE ----
BLOODHOUND_HOST=0.0.0.0
BLOODHOUND_PORT=8080
BLOODHOUND_TAG=latest

# ---- Database credentials (change these for anything but local lab use) ----
POSTGRES_USER=bloodhound
POSTGRES_PASSWORD=bloodhoundcommunityedition
POSTGRES_DB=bloodhound

NEO4J_USER=neo4j
NEO4J_SECRET=bloodhoundcommunityedition
NEO4J_ALLOW_UPGRADE=true
